@Tutorial(time: 10, projectFiles: "OUDS-Eiffel-Tutorial.zip") {
    @Intro(title: "Introduction") {
        Welcome to the Eiffel theme tutorial! In this tutorial, you will learn how to create a custom OUDS theme by overriding tokens from the Orange theme.

        The Eiffel theme will feature green, black, gray, and yellow colors. We will customize colors, radius, spacings, borders, elevations, colored surfaces, and fonts.

        @Image(source: "ic_theme_intro", alt: "OUDS themes logo")
    }

    @XcodeRequirement(title: "Xcode 26.5", destination: "https://developer.apple.com/download/")

    @Section(title: "Starting point") {

        @ContentAndMedia {
            We start with a complete app using the default Orange theme. This app contains various OUDS components that we will customize throughout the tutorial:

            - OUDSTag (multiple categories)
            - OUDSRadioPicker
            - OUDSTextInput
            - OUDSChipPicker
            - OUDSHorizontalDivider
            - OUDSCheckboxItem
            - OUDSColoredSurface
            - OUDSLink
            - OUDSButton
            - OUDSSwitchItem
        }

        @Steps {
            @Step {
                Let's start by seeing the app with the default Orange theme. The EiffelTheme class is created but doesn't override any tokens yet.

                @Code(name: "Tutorial.swift", file: "tutorial-eiffel-1-1.swift") {
                    @Image(source: "tutorial-eiffel-1-1.png", alt: "App with default Orange theme")
                }
            }

            @Step {
                Now let's create the EiffelTheme class by subclassing OrangeTheme. This is the Strategy A approach - the recommended way to create a custom theme.

                @Code(name: "Tutorial.swift", file: "tutorial-eiffel-1-2.swift") {
                    @Image(source: "tutorial-eiffel-1-2.png", alt: "App with empty Eiffel theme")
                }
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            What is the recommended strategy to create a custom OUDS theme?

            @Choice(isCorrect: true) {
                Subclass OrangeTheme
                
                @Justification(reaction: "Correct!") {
                    Maybe the most simple solution.
                }
            }

            @Choice(isCorrect: false) {
                Create a theme from scratch on OUDSTheme (Strategy B)
                
                @Justification(reaction: "... OK correct also.") {
                    Not the better choice as it can imply more work.
                }
            }
        }
    }
}

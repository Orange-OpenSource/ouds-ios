@Tutorial(time: 15, projectFiles: "OUDS-Eiffel-Tutorial.zip") {
    @Intro(title: "Fonts and Tunings") {
        Font tokens control typography throughout the app. In this final chapter, we will override font tokens and apply tunings to components.

        We'll also add tunings to make buttons, text inputs, and alert messages rounded.

        @Image(source: "ic_fonts", alt: "OUDS fonts logo")
    }

    @XcodeRequirement(title: "Xcode 26.5", destination: "https://developer.apple.com/download/")

    @Section(title: "Overriding font tokens") {

        @ContentAndMedia {
            Font tokens are defined in `OrangeThemeFontSemanticTokensProvider`. We will override heading and label fonts.

            Tunings allow us to customize component-specific properties like border radius.
        }

        @Steps {
            @Step {
                Start with the theme from the colored surface chapter.

                @Code(name: "Tutorial.swift", file: "tutorial-eiffel-8-1.swift") {
                    @Image(source: "tutorial-eiffel-8-1.png", alt: "App before font overrides")
                }
            }

            @Step {
                Now let's add the font provider with typography overrides.

                @Code(name: "Tutorial.swift", file: "tutorial-eiffel-8-2.swift") {
                    @Image(source: "tutorial-eiffel-8-2.png", alt: "App with Eiffel fonts")
                }
            }

            @Step {
                Finally, let's add tunings to components. We'll override button, textInput, and alertMessage component tokens to add rounded corners.

                This is the final Eiffel theme with all customizations:
                - Green brand colors
                - Rounded components (radius800)
                - Larger spacings
                - Dashed borders
                - Stronger shadows
                - Green colored surface
                - Custom fonts
                - Rounded component tunings

                @Code(name: "Tutorial.swift", file: "tutorial-eiffel-8-3.swift") {
                    @Image(source: "tutorial-eiffel-8-3.png", alt: "App with Eiffel theme complete")
                }
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            What are tunings in OUDS?

            @Choice(isCorrect: true) {
                Customizations of component-specific properties like border radius
            }

            @Choice(isCorrect: false) {
                Overrides of semantic tokens
            }
        }
    }
}

@Tutorial(time: 10, projectFiles: "OUDS-Eiffel-Tutorial.zip") {
    @Intro(title: "Radius") {
        Radius tokens control the corner radius of components. In this chapter, we will override border radius tokens to create rounded components.

        We will use a larger radius (radius800) to give components a softer, more modern look.

        @Image(source: "ic_theme_intro", alt: "OUDS themes logo")
    }

    @XcodeRequirement(title: "Xcode 26.5", destination: "https://developer.apple.com/download/")

    @Section(title: "Overriding radius tokens") {

        @ContentAndMedia {
            Border radius tokens are defined in `OrangeThemeBorderSemanticTokensProvider`. We will override `radiusMedium` to make components more rounded.

            The Eiffel theme uses radius800 (16px) for a pronounced rounded look.
        }

        @Steps {
            @Step {
                Start with the theme from the colors chapter, which already has color overrides.

                @Code(name: "Tutorial.swift", file: "tutorial-eiffel-3-1.swift") {
                    @Image(source: "tutorial-eiffel-3-1.png", alt: "App before radius overrides")
                }
            }

            @Step {
                Now let's add the border provider with radius overrides. We will override `radiusMedium` to use a larger radius.

                @Code(name: "Tutorial.swift", file: "tutorial-eiffel-3-2.swift") {
                    @Image(source: "tutorial-eiffel-3-2.png", alt: "App with Eiffel radius")
                }
            }
        }
    }
}
